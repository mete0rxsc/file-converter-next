<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType><Platform>x64</Platform><OutputName>FileConverter-3.0.3-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
    <!-- Package is intentionally per-user only; ICE91's per-machine scenario cannot apply. -->
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup><Compile Include="obj/Payload.wxs"/></ItemGroup>
  <Target Name="GeneratePayload" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\Generate-Payload.ps1&quot; -PublishDir &quot;$(PublishDir).&quot; -Output &quot;$(MSBuildThisFileDirectory)obj\Payload.wxs&quot;"/>
  </Target>
</Project>
