<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <AssemblyName>FileConverterNext</AssemblyName>
        <ApplicationIcon>Assets\application.ico</ApplicationIcon>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\FileConverterNext.Core\FileConverterNext.Core.csproj"/>
        <ProjectReference Include="..\src\FileConverterNext.Windows\FileConverterNext.Windows.csproj"/>
        <ProjectReference Include="..\src\FileConverterNext.Worker\FileConverterNext.Worker.csproj" ReferenceOutputAssembly="false"/>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    </ItemGroup>
    <Target Name="CopyConversionWorker" AfterTargets="Build">
        <ItemGroup><WorkerFiles Include="..\src\FileConverterNext.Worker/bin/$(Configuration)/net10.0-windows/**" Exclude="..\src\FileConverterNext.Worker/bin/$(Configuration)/net10.0-windows/**/*.pdb"/></ItemGroup>
        <Copy SourceFiles="@(WorkerFiles)" DestinationFiles="@(WorkerFiles->'$(OutDir)worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
    </Target>
</Project>
