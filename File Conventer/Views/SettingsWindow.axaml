<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:File_Conventer.ViewModels" x:Class="File_Conventer.Views.SettingsWindow"
        x:DataType="vm:MainViewModel" Title="{Binding L[Settings]}" Width="1050" Height="700" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/application.ico">
  <Grid RowDefinitions="*,Auto,Auto" Margin="5">
    <TabControl SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{Binding L[ConversionPresets]}">
        <Grid ColumnDefinitions="*,3.5*" Margin="5">
          <Grid RowDefinitions="*,Auto" Margin="0,0,5,0">
            <TreeView Name="PresetList" ItemsSource="{Binding PresetTree}" SelectedItem="{Binding SelectedTreeNode}" DragDrop.AllowDrop="True">
              <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style></TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:PresetTreeNode" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="3">
                    <Image Source="/Assets/FolderIcon.ico" Width="24" Height="24" IsVisible="{Binding IsFolder}"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding L[CreateANewFolder]}" Click="NewFolder"/>
                  <MenuItem Header="{Binding L[AddNewPreset]}" Command="{Binding NewPresetCommand}"/>
                  <MenuItem Header="{Binding L[DuplicatePreset]}" Command="{Binding DuplicatePresetCommand}"/>
                  <Separator/>
                  <MenuItem Header="{Binding L[ImportPresets]}" Click="ImportPresets"/>
                  <MenuItem Header="{Binding L[ExportSelectedPresets]}" Click="ExportPresets"/>
                  <Separator/>
                  <MenuItem Header="{Binding L[RemoveSelectedPreset]}" Click="DeleteSelected"/>
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>
            <Button Grid.Row="1" Content="{Binding L[Help]}" Command="{Binding OpenHelpCommand}" Classes="link" HorizontalAlignment="Left"/>
          </Grid>
          <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="5">
            <Grid>
              <StackPanel IsVisible="{Binding IsFolderSelected}" Spacing="8">
                <TextBlock Text="{Binding L[PresetFolder]}" FontWeight="Bold"/>
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="{Binding L[PresetFolderName]}" VerticalAlignment="Center" Margin="5"/>
                  <TextBox Grid.Column="1" Text="{Binding FolderLeafName}" LostFocus="RenameFolder"/>
                </Grid>
              </StackPanel>
              <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsPresetSelected}">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                  <TextBlock Text="{Binding L[PresetName]}" VerticalAlignment="Center" Margin="5"/>
                  <TextBox Grid.Column="1" Text="{Binding PresetLeafName}" LostFocus="RefreshPresetTree"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="2.5*,*" ColumnSpacing="5">
                  <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="5">
                    <ScrollViewer>
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[OutputFormat]}" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding OutputTypes}" SelectedItem="{Binding PresetOutput}" HorizontalAlignment="Stretch"/>
                        <ItemsControl ItemsSource="{Binding Parameters}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetParameter">
                              <Grid ColumnDefinitions="110,*" Margin="0,4" IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding IsText}" AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding FlagValue}" IsVisible="{Binding IsFlag}"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding NumberValue}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Increment}" IsVisible="{Binding IsNumber}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Choices}" IsVisible="{Binding IsRadio}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParameterChoice"><RadioButton Content="{Binding Label}" IsChecked="{Binding IsChecked}" GroupName="{Binding GroupName}" Margin="0,0,8,0"/></DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Grid.Column="1" ColumnDefinitions="*,65" IsVisible="{Binding IsSlider}">
                                  <Slider Value="{Binding SliderValue}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Increment}" IsSnapToTickEnabled="True" Ticks="{Binding Ticks}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" VerticalAlignment="Center" Margin="5,0"/>
                                </Grid>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator/>
                        <TextBlock Text="{Binding L[FileNameTemplate]}"/>
                        <TextBox Text="{Binding PresetTemplate}" ToolTip.Tip="{Binding L[OutputFilePathTemplateHelp]}"/>
                        <TextBlock Text="{Binding PreviewOutput}" FontSize="10" Foreground="#808080" TextWrapping="Wrap"/>
                        <Button Content="{Binding L[Help]}" Command="{Binding OpenTemplateHelpCommand}" Classes="link" HorizontalAlignment="Left"/>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                  <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="5">
                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                      <TextBlock Text="{Binding L[InputFormats]}" FontWeight="Bold" Margin="0,0,0,6"/>
                      <TreeView Grid.Row="1" ItemsSource="{Binding InputCategories}">
                        <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="24"/></Style></TreeView.Styles>
                        <TreeView.DataTemplates>
                          <TreeDataTemplate DataType="{x:Type vm:InputCategory}" ItemsSource="{Binding Extensions}">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsThreeState="True" MinHeight="24"/>
                          </TreeDataTemplate>
                          <DataTemplate DataType="{x:Type vm:InputExtension}">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" MinHeight="24"/>
                          </DataTemplate>
                        </TreeView.DataTemplates>
                      </TreeView>
                      <TextBox Grid.Row="2" Text="{Binding CustomInputExtensions}" PlaceholderText="{Binding L[StringMiscName]}" ToolTip.Tip="{Binding L[InputExtensions]}"/>
                      <TextBlock Grid.Row="3" Text="{Binding L[ActionWhenConversionSucceedTitle]}" TextWrapping="Wrap" Margin="0,8,0,3"/>
                      <ComboBox Grid.Row="4" ItemsSource="{Binding PostActionOptions}" SelectedItem="{Binding SelectedPostAction}" HorizontalAlignment="Stretch"/>
                      <TextBox Grid.Row="5" Text="{Binding PresetArchive}" IsVisible="{Binding IsArchiveAction}" PlaceholderText="{Binding L[ArchiveDirectory]}"/>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              <TextBlock Text="{Binding L[NoPresetSelected]}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsNothingSelected}" FontSize="20"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding L[Application]}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="5" RowSpacing="7">
          <TextBlock Text="{Binding L[Language]}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.Language}" HorizontalAlignment="Stretch"/>
          <TextBlock Grid.Row="1" Text="{Binding L[MaximumNumberOfSimultaneousConversions]}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
          <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.MaximumNumberOfSimultaneousConversions}"/>
          <TextBlock Grid.Row="2" Text="{Binding L[AutomaticallyExitWhenAllConversionsFinished]}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
          <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Settings.ExitApplicationWhenConversionsFinished}"/>
          <TextBlock Grid.Row="3" Text="{Binding L[ExitWaitingDuration]}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Slider Width="250" Minimum="0" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Settings.DurationBetweenEndOfConversionsAndApplicationExit}"/>
            <TextBlock Text="{Binding Settings.DurationBetweenEndOfConversionsAndApplicationExit, StringFormat='{}{0:0.0} s'}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Row="4" Text="{Binding L[AutomaticallyCheckForUpdates]}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
          <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Settings.Updates.CheckAtStartup}"/>
          <TextBlock Grid.Row="5" Text="{Binding L[CopyFilesInClipboardAfterConversion]}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
          <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Settings.CopyFilesInClipboardAfterConversion}"/>
          <TextBlock Grid.Row="6" Text="{Binding L[HardwareAccelerationMode]}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
          <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding HardwareModes}" SelectedItem="{Binding Settings.HardwareAccelerationMode}" HorizontalAlignment="Stretch"/>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding L[About]}">
        <Grid ColumnDefinitions="*,256" RowDefinitions="50,*,Auto,30" Margin="5">
          <TextBlock Text="{Binding VersionLabel}" FontSize="28"/>
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap"/>
              <Button Content="{Binding L[SeeChangeLog]}" Click="ShowUpgrade" Classes="link"/>
              <TextBlock Text="GNU GPLv3 · Adrien Allard and contributors" Foreground="#808080"/>
            </StackPanel>
          </ScrollViewer>
          <Image Grid.Row="1" Grid.Column="1" Source="/Assets/application.ico" Width="216" Height="216" VerticalAlignment="Top" Margin="20"/>
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding L[Help]}" Command="{Binding OpenHelpCommand}" Classes="link"/>
            <Button Content="GitHub" Command="{Binding OpenProjectCommand}" Classes="link"/>
          </StackPanel>
          <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Copyright © 2026 Adrien Allard and contributors." Foreground="#808080" FontSize="11" VerticalAlignment="Bottom"/>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="#808080" FontSize="11" TextWrapping="Wrap" Margin="5"/>
    <Button Grid.Row="2" Content="{Binding L[Save]}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" MinWidth="100" Margin="0,4,0,0"/>
  </Grid>
</Window>
